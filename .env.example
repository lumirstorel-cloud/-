# ==============================================================================
# LUMIR — لومير | ملف إعدادات متغيرات البيئة للإنتاج (.env.example)
# ==============================================================================
# إرشادات هامة للأمان:
# 1. انسخي هذا الملف باسم '.env' في مجلد المشروع الرئيسي.
# 2. لا ترفعي ملف '.env' الفعلي إلى Git أو مستودعات الأكواد العامة.
# 3. استبدلي القيم التوضيحية أدناه ببياناتكِ وبيانات الإنتاج الحقيقية.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الخادم والبيئة (Server & Environment)
# ------------------------------------------------------------------------------
# منفذ الخادم (الافتراضي للتشغيل المحلي والإنتاج هو 3000)
PORT=3000

# بيئة التشغيل: 'development' للتطوير المحلي، أو 'production' للنشر الفعلي
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. أمان تسجيل دخول المشرفين (Admin Authentication & Secrets)
# ------------------------------------------------------------------------------
# المفتاح السري لتشفير رموز المصادقة (JWT Secret)
# ضعي نصاً عشوائياً قوياً ومشفراً لا يقل عن 32 حرفاً ورمزاً (مثال: توليد عبر openssl rand -hex 32)
ADMIN_JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters

# البريد الإلكتروني الافتراضي للمديرة العامة (Super Admin)
ADMIN_EMAIL=lumir.store.l@gmail.com

# كلمة المرور المبدئية للمسؤول (يجب تغييرها فور أول تسجيل دخول)
ADMIN_DEFAULT_PASSWORD=replace_with_strong_initial_admin_password

# ------------------------------------------------------------------------------
# 3. بيانات التواصل وواتساب المعتمد (Store Contact & WhatsApp)
# ------------------------------------------------------------------------------
# رقم واتساب المحلي داخل المملكة (مثال: 0579105700)
DEFAULT_WHATSAPP_NUMBER=0579105700

# الصيغة الدولية لرقم واتساب بدون رمز الزائد (مثال: 966579105700)
DEFAULT_WHATSAPP_INTERNATIONAL=966579105700

# البريد الرسمي المعتمد للتواصل
DEFAULT_CONTACT_EMAIL=lumir.store.l@gmail.com

# ------------------------------------------------------------------------------
# 4. إعدادات Firebase الاختيارية (إذا تم تفعيل Firebase في الإنتاج)
# ------------------------------------------------------------------------------
# معرف مشروع Firebase الخاص بكِ (Project ID)
# ملاحظة أمنية: معرف المشروع ليس سراً بحد ذاته، ولكن يتم تقييد الصلاحيات عبر قواعد firestore.rules
VITE_FIREBASE_PROJECT_ID=lumir-events-sa

# مفتاح API الخاص بواجهة الويب في Firebase (Web API Key)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here

# نطاق المصادقة (Auth Domain)
VITE_FIREBASE_AUTH_DOMAIN=lumir-events-sa.firebaseapp.com

# مستودع التخزين السحابي للصور والفيديوهات (Storage Bucket)
VITE_FIREBASE_STORAGE_BUCKET=lumir-events-sa.appspot.com

# معرف المراسلة (Messaging Sender ID)
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here

# معرف التطبيق (App ID)
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------------------------------------------
# 5. حدود الأمان وحجم الملفات (Upload Limits)
# ------------------------------------------------------------------------------
# الحد الأقصى لحجم صور المعرض المرفوعة (بالميجابايت - الافتراضي 5MB)
MAX_IMAGE_UPLOAD_MB=5

# الحد الأقصى لحجم مقاطع الفيديو المرفوعة (بالميجابايت - الافتراضي 25MB)
MAX_VIDEO_UPLOAD_MB=25